<resources>
    <!-- Circa: replace the phone notification shade / quick settings with the round Wear-style
         tray (com.android.systemui.circa.shade). Off by default; a product overlay turns it on.
         For testing on a userdebug build, `settings put global circa_wear_shade 1` and a
         SystemUI restart also turn it on. -->
    <bool name="config_circaWearShade">false</bool>

    <!-- Circa: the tray's accent (active toggles, card titles, rings). Settings.Secure
         "circa_accent_color" (an ARGB int) overrides it at runtime. -->
    <color name="circa_shade_accent">#ff8ab4f8</color>

    <!-- Circa: height of the top / bottom screen edge band a swipe must start in to open the
         tray at its quick-settings / notifications end. -->
    <dimen name="circa_shade_edge_top">36dp</dimen>
    <dimen name="circa_shade_edge_bottom">36dp</dimen>

    <!-- Circa: the quick-settings tiles the Circa shade starts with (written to sysui_qs_tiles
         once, the first time the shade runs; edit mode changes them afterwards). -->
    <string name="circa_qs_tiles_default" translatable="false">modes_dnd,theater,bt,wifi,battery,circa_brightness,circa_settings</string>

    <string name="circa_theater_mode">Theater mode</string>
    <string name="circa_brightness">Brightness</string>
    <string name="circa_settings">Settings</string>
    <string name="circa_edit_tiles">Edit</string>
    <string name="circa_edit_done">Done</string>
    <string name="circa_add_tiles">Add tiles</string>

    <!-- Circa: side inset of the brightness dialog's slider so its round ends stay inside the circle
         (px on purpose: the panel is 384 px whatever the density). -->
    <dimen name="circa_dialog_side_inset">44px</dimen>

    <!-- Circa volume indicator (circa/dialogs/CircaVolumeDialog) -->
    <string name="circa_volume_media">Media</string>
    <string name="circa_volume_ring">Ringtone</string>
    <string name="circa_volume_alarm">Alarm</string>
    <string name="circa_volume_call">Call</string>
    <string name="circa_volume_notification">Notifications</string>
    <string name="circa_volume_system">System</string>
</resources>
